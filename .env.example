# Copia este archivo como .env.local y rellena los valores reales.
# Nunca comitees .env.local ni ningún archivo con credenciales reales.

# ─── Portal (tiempo real) ─────────────────────────────────────────────────────
# Clave publishable (pk_...): segura en el bundle del cliente
NEXT_PUBLIC_PORTAL_KEY=
# Clave secreta (sk_...): SOLO servidor (director). Publica en el canal via REST.
PORTAL_SECRET=

# ─── Anthropic (elegías) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Supabase (archivo de funerales) ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: SOLO el director (escrituras en la tabla funerales)
SUPABASE_SERVICE_ROLE_KEY=

# ─── Configuración de la app ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
